# Claude chat / context (50MB limit) – exclude large or generated files
# Keep: all source (app/, scripts/, config), README, missing_details.json, this file

# Dependencies & build (largest)
node_modules/
.next/
out/
build/
.vercel/

# Env & secrets
.env*
*.pem

# Large data – structure documented in data/ifsc/README.md + SCHEMA.md
data/ifsc/IFSC.json.gz
data/ifsc/IFSC (1).json.gz
data/ifsc/IFSC (1).json
data/ifsc/merged_banks.json
data/ifsc/submember_banks.json
data/ifsc/npci_ifsc_lookup.json
data/ifsc/npci_ifsc_lookup.min.json

# Optional: lockfile is ~230KB; uncomment if you need to stay under strict limit
# package-lock.json

# Misc (same as .gitignore where relevant)
.pnp
.pnp.*
.yarn/*
coverage/
.DS_Store
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

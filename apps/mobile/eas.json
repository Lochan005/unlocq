{
    "cli": {
      "version": ">= 10.0.0",
      "appVersionSource": "local"
    },
    "build": {
      "development": {
        "developmentClient": true,
        "distribution": "internal",
        "ios": {
          "simulator": true
        },
        "env": {
          "APP_ENV": "development"
        }
      },
      "preview": {
        "distribution": "internal",
        "env": {
          "APP_ENV": "preview"
        }
      },
      "production": {
        "env": {
          "APP_ENV": "production"
        }
      }
    },
    "submit": {
      "production": {}
    }
  }             